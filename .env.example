# Google Gemini API Key
# Obtenha gratuitamente em: https://aistudio.google.com
GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.6-flash

# Configurações do Orquestrador Hermes (Nous Research) via OpenRouter
NOUS_API_KEY=sua_chave_openrouter_aqui
NOUS_BASE_URL=https://openrouter.ai/api/v1
NOUS_MODEL_NAME=nousresearch/hermes-3-llama-3.1-405b

# Configurações do servidor
HOST=localhost
PORT=8000

# Pastas do sistema
INBOX_FOLDER=inbox
PROCESSED_FOLDER=processed
OUTPUTS_FOLDER=outputs

# [Opcional] Disparo de E-mails via SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu_email@gmail.com
# SMTP_PASS=sua_senha_de_app
# SMTP_FROM=seu_email@gmail.com

# [Opcional] Disparo de Mensagens via Telegram Bot
# TELEGRAM_BOT_TOKEN=seu_bot_token_aqui
# TELEGRAM_CHAT_ID=seu_chat_id_aqui
